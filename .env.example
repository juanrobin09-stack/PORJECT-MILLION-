# --- Core ---
SONA_DATABASE_URL=sqlite:///./sona.db
SONA_ENV=development

# --- AI (required for enrichment/replies/ask) ---
ANTHROPIC_API_KEY=sk-ant-...

# Model tiers (defaults shown)
SONA_MODEL_ENRICH=claude-haiku-4-5
SONA_MODEL_GENERATE=claude-opus-4-8

# --- Connectors (optional; the ingest API works without them) ---
GOOGLE_BUSINESS_API_KEY=
TRUSTPILOT_API_KEY=

# --- Benchmarks ---
# A segment publishes only when >= this many distinct orgs contribute
SONA_BENCHMARK_MIN_ORGS=5
