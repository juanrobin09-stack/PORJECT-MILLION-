# --- Core ---
RESONA_DATABASE_URL=sqlite:///./resona.db
RESONA_ENV=development

# --- AI (required for live analysis/response generation) ---
ANTHROPIC_API_KEY=sk-ant-...

# Model tiers (defaults shown; override to trade cost vs quality)
RESONA_MODEL_RESPONSE=claude-opus-4-8
RESONA_MODEL_TRIAGE=claude-haiku-4-5
RESONA_MODEL_INSIGHTS=claude-opus-4-8

# --- Billing (optional in development) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Connectors (optional; webhook ingestion works without them) ---
GOOGLE_BUSINESS_API_KEY=
TRUSTPILOT_API_KEY=

# --- Alerting ---
RESONA_ALERT_WEBHOOK_URL=   # Slack/Discord-compatible webhook for risk alerts
